  "findings": [
    {
      "code": "SITE-07",
      "severity": "major",
      "title": "At least 17 links and buttons on 3 pages have nothing for a screen reader to say",
      "where": [
        {
          "url": "https://www.thehatchgrp.com/why-choose-us",
          "says": "`<a class=\"primary-btn\">`"
        },
        {
          "url": "https://www.thehatchgrp.com/for-clients",
          "says": "`<a href=\"#\">`"
        },
        {
          "url": "https://www.thehatchgrp.com/our-team",
          "says": "`<a href=\"https://www.linkedin.com/in/greg-roth-a451548/\">`"
        },
        {
          "url": "https://www.thehatchgrp.com/our-team",
          "says": "`<a href=\"https://www.linkedin.com/in/erik-jacobs-7b60811/\">`"
        },
        {
          "url": "https://www.thehatchgrp.com/our-team",
          "says": "`<a href=\"https://www.linkedin.com/in/jpiehowski/\">`"
        },
        {
          "url": "https://www.thehatchgrp.com/our-team",
          "says": "`<a href=\"https://www.linkedin.com/in/alex-webb-6b39b181/\">`"
        },
        {
          "url": "https://www.thehatchgrp.com/our-team",
          "says": "`<a href=\"https://www.linkedin.com/in/sam-roth-29755a169/\">`"
        }
      ],
      "listed": [
        "link or button",
        "links and buttons"
      ],
      "why": "A blind visitor hears only \"link\" or \"button\", with no idea where it goes or what it does; accessibility law (the ADA, the European Accessibility Act) counts it, and so do automated accessibility audits.",
      "fix": "Give each one words: visible text, an aria-label, or an alt on the image inside it (an icon link to a cart: aria-label=\"Cart\")."
    },
    {
      "code": "SITE-33",
      "severity": "major",
      "listed": [
        "link",
        "links"
      ],
      "title": "1 link to another site leads nowhere: the page is gone",
      "where": [
        {
          "url": "https://the-hatch-group-242355921.hubspotpagebuilder.net/privacy-policy?hsLang=en",
          "says": "answered 404; linked from /, /contact-us, /for-consultants, /why-choose-us, /for-clients and 2 more",
          "link": {
            "paths": [],
            "status": 404,
            "answer": "answered 404",
            "from": [
              "/",
              "/contact-us",
              "/for-consultants",
              "/why-choose-us",
              "/for-clients"
            ],
            "more": 2,
            "why": "broken"
          },
          "offSite": true
        }
      ],
      "why": "Sites move and close: a visitor who follows one of these links meets an error page, or nothing at all, on someone else's site, reached from this one.",
      "fix": "Point each link at where the page lives now, or take it out. The suite's link report asks every one again on each run, and fails when one that answered stops."
    },
    {
      "code": "SITE-15",
      "severity": "minor",
      "title": "1 page has no main heading; 1 page has several main headings (h1)",
      "where": [
        {
          "url": "https://www.thehatchgrp.com/for-clients",
          "says": "no h1 with words shown"
        },
        {
          "url": "https://www.thehatchgrp.com/for-clients/enterprise-platforms",
          "says": "2 h1: `SALESFORCE`, `MEET JUSTIN PIEHOWSKI`"
        }
      ],
      "why": "Screen reader users jump to the h1 to learn what a page is, and search engines read it as the page's subject; none, or several competing, says neither.",
      "fix": "Give each page one h1 naming what it shows; the site's name in the header is not it."
    },
    {
      "code": "SITE-24",
      "severity": "minor",
      "listed": [
        "missing header",
        "missing headers"
      ],
      "title": "2 security headers no page sends",
      "where": [
        {
          "url": "https://www.thehatchgrp.com/",
          "says": "no page of the site sends X-Frame-Options or frame-ancestors (another site cannot frame it to trick a click)"
        },
        {
          "url": "https://www.thehatchgrp.com/",
          "says": "no page of the site sends X-Content-Type-Options: nosniff"
